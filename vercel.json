{
  "version": 2,
  "rewrites": [
    { "source": "/api/room/:code/vote", "destination": "/api/room/[code]" },
    { "source": "/api/room/:code/finish", "destination": "/api/room/[code]" },
    { "source": "/api/room/:code/state", "destination": "/api/room/[code]" },
    { "source": "/api/room/:code", "destination": "/api/room/[code]" },

    { "source": "/api/auth/signup", "destination": "/api/auth?action=signup" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },
    { "source": "/api/auth/google", "destination": "/api/auth?action=google" },
    { "source": "/api/auth/change-password", "destination": "/api/auth?action=change-password" },

    { "source": "/api/users/me", "destination": "/api/users?action=me" },
    { "source": "/api/users/dietary", "destination": "/api/users?action=dietary" },
    { "source": "/api/users/search", "destination": "/api/users?action=search" },

    { "source": "/api/been-there/:id", "destination": "/api/been-there?id=:id" },
    { "source": "/api/wish-list/:id", "destination": "/api/wish-list?id=:id" },

    { "source": "/api/friends/add", "destination": "/api/friends?action=add" },
    { "source": "/api/friends/:id/wishlist", "destination": "/api/friends?action=wishlist&id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
